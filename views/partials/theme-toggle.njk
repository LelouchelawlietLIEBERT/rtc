<button
  type="button"
  class="btn btn-ghost btn-icon theme-toggle"
  data-theme-toggle
  aria-label="Switch to dark theme"
  title="Switch theme"
>
  <span class="theme-toggle__sun" aria-hidden="true">
    <i data-lucide="sun"></i>
  </span>
  <span class="theme-toggle__moon" aria-hidden="true">
    <i data-lucide="moon"></i>
  </span>
</button>
