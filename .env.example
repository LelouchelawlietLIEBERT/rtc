# ---------------------------------------------------------------------------
# RTC configuration
# Copy this file to .env and adjust values. Never commit .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# Public origin used for invite links and origin checks.
# In production this must be the exact origin users open in the browser.
# On Render, set APP_URL=https://<your-service>.onrender.com.
APP_URL=http://localhost:3000

# Extra browser origins allowed to call the HTTP API and Socket.IO server.
# Comma-separated, origins only (scheme + host + port, no path).
# CORS_ORIGINS=https://app.example.com,https://staging.example.com

# Trust X-Forwarded-* headers. Render terminates TLS at its proxy.
# Set to true behind a reverse proxy; defaults to true when NODE_ENV=production.
TRUST_PROXY=false

# debug | info | warn | error | silent
LOG_LEVEL=info

# Rooms and participants
MAX_PARTICIPANTS=8
ROOM_TTL_MINUTES=180

# ICE servers. Defaults to Google's public STUN servers when omitted.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
#
# TURN is strongly recommended for production. All three values are required
# when TURN_URLS is set.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=rtc
# TURN_CREDENTIAL=replace-with-a-secret

# HTTP and Socket.IO rate limits (per IP / window, see README).
RATE_LIMIT_API_PER_MINUTE=180
RATE_LIMIT_CREATE_PER_10_MINUTES=30
RATE_LIMIT_LOOKUP_PER_MINUTE=120
RATE_LIMIT_SOCKET_CONNECTS_PER_MINUTE=60
